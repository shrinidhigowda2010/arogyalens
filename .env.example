# ArogyaLens configuration. Copy to `.env` (git-ignored) for local runs, or set these
# as environment variables on Render / Cloud Run. Never commit real keys.

# --- Google Gemini (required for photo scans and AI answers) -------------------------
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
# Comma-separated models tried in order on 429/404/5xx/timeout.
GEMINI_FALLBACK_MODELS=gemini-flash-latest,gemini-flash-lite-latest
GEMINI_TTS_MODEL=gemini-2.5-flash-preview-tts
AI_ENABLED=true
AI_TIMEOUT_MS=45000
AI_CACHE_MAX_ENTRIES=200
AI_CACHE_TTL_SECONDS=900

# --- Google Maps Platform (optional: live doctor listings via Places API (New)) ------
# Without it the doctor finder shows Google Maps / Practo / eSanjeevani deep links.
GOOGLE_MAPS_API_KEY=

# --- Database (optional: "My history") -----------------------------------------------
# postgres://user:pass@host:5432/db  (converted to JDBC with sslmode=require).
# Empty = in-memory H2 (history is lost on restart).
DATABASE_URL=
DATABASE_SSLMODE=require
HISTORY_ENABLED=true
HISTORY_MAX_ENTRIES=50

# --- Web / security ------------------------------------------------------------------
# Extra origins allowed to call /api (the bundled frontend is same-origin and needs none).
ALLOWED_ORIGINS=http://localhost:5173
RATE_LIMIT_PER_MINUTE=20
DEMO_ENABLED=false
# Local port (Render/Cloud Run inject PORT automatically).
SERVER_PORT=8088

# --- Frontend (Vite, build time) -----------------------------------------------------
# Leave empty: dev uses the Vite proxy, production is same-origin.
VITE_API_URL=
